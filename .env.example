# Port to listen on (default 3000)
PORT=3000

# Base URL for unsubscribe links and public assets
APP_URL="http://localhost:3000"

# Default Email Provider: 'gmail' | 'smtp' | 'resend' | 'sendgrid' | 'ses' | 'mailgun' | 'sandbox'
EMAIL_PROVIDER="gmail"

# SMTP Configuration (when EMAIL_PROVIDER=smtp or ses-smtp)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# API Key (when EMAIL_PROVIDER is resend, sendgrid, mailgun, etc.)
EMAIL_API_KEY=""

# Mailgun Specific (Optional)
MAILGUN_DOMAIN=""

# Default Sender Identity
DEFAULT_FROM_NAME="Campaign Manager"
DEFAULT_FROM_EMAIL="newsletter@yourcompany.com"
DEFAULT_REPLY_TO=""

# Queue and Throughput Configuration
BATCH_SIZE=50
BATCH_DELAY_MS=1000
MAX_RETRIES=3
DAILY_SENDING_LIMIT=10000
